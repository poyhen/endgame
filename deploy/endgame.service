[Unit]
Description=Endgame Telegram media bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=endgame
Group=endgame
StateDirectory=endgame
StateDirectoryMode=0700
WorkingDirectory=/var/lib/endgame
Environment=HOME=/var/lib/endgame
EnvironmentFile=/etc/endgame/environment
ExecStart=/opt/endgame/current/bin/endgame
StandardInput=null
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=30s
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=120s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
